# ── Core ─────────────────────────────────────────────────────────────────────
# Full public URL of this deployment, including any subpath.
# Used to build report links in emails and PDF reports.
#
# Subdomain deployment:  NEXT_PUBLIC_APP_URL=https://quiz.yourdomain.com
# Subpath deployment:    NEXT_PUBLIC_APP_URL=https://yourdomain.com/quiz/aireadiness
NEXT_PUBLIC_APP_URL=https://accelerator-x.ai/quiz/aireadiness

# Template to activate. Default: ai-readiness.
SCOREKIT_TEMPLATE_ID=ai-readiness

# Base path for subpath deployments (e.g. /quiz/aireadiness).
# Must start with / — leave unset for standalone subdomain deployments.
# Must match the subpath in NEXT_PUBLIC_APP_URL above.
NEXT_PUBLIC_BASE_PATH=/quiz/aireadiness

# ── n8n Webhook (fire-and-forget lead ingestion → Airtable) ──────────────────
# Webhook URL from your n8n instance. Receives full quiz payload on submission.
NEXT_PUBLIC_N8N_WEBHOOK_URL=https://your-n8n.example.com/webhook/scorekit/quiz-submit

# ── Report Storage (Upstash Redis / Vercel KV) ────────────────────────────────
# Create at: https://console.upstash.com  or  Vercel Dashboard → Storage → KV
# Without these, report storage falls back to localStorage (dev/preview only —
# links won't work across devices or browsers).
UPSTASH_REDIS_REST_URL=https://your-db-id.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# ── Email Delivery ────────────────────────────────────────────────────────────
EMAIL_PROVIDER=brevo
BREVO_API_KEY=xkeysib-...
EMAIL_FROM=reports@yourdomain.com
EMAIL_FROM_NAME=Your Brand Name
